# =======================================================
# SomnoPulse AI - Environment Configuration Example
# Copy this file to .env for custom local deployments
# =======================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Security & Cross-Origin Configuration
CORS_ORIGIN=*

# Rate Limiting Configuration
# Window size in milliseconds (e.g., 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per IP address within the window
RATE_LIMIT_MAX=250

# Application Metadata
APP_NAME="SomnoPulse AI"
APP_VERSION="2.0.0"
